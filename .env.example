# ==============================================================================
# WINTER ARC — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# DO NOT COMMIT REAL SECRETS TO GIT. USE STRONG PLACEHOLDERS IN RAILWAY DASHBOARD.
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=generate-a-secure-50-char-random-key-in-railway
DJANGO_DEBUG=False
DJANGO_TIME_ZONE=Asia/Kolkata
ALLOWED_HOSTS=.railway.app,winterarc.com,www.winterarc.com

# PostgreSQL Database (Railway Variable Reference: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgres://postgres:password@host:5432/railway

# Redis Cache & Celery Broker (Railway Variable Reference: ${{Redis.REDIS_URL}})
REDIS_URL=redis://default:password@host:6379

# Security & HTTPS Configuration
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
CSRF_TRUSTED_ORIGINS=https://winter-arc-production.up.railway.app,https://winterarc.com
CORS_ALLOWED_ORIGINS=https://winter-arc-production.up.railway.app,https://winterarc.com

# Celery Configuration
CELERY_TIMEZONE=Asia/Kolkata

# Production Email / SMTP Configuration
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-api-key
DEFAULT_FROM_EMAIL=Winter Arc <noreply@winterarc.com>

# Logging
DJANGO_LOG_LEVEL=INFO


